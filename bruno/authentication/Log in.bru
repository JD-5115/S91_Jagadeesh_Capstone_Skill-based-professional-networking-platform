meta {
  name: Log in
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  username: {{username}}
  password: {{password}}
}

docs {
  Returns a JWT, username, bio, and skills. Copy the token into the local environment's token variable for authenticated requests.
}